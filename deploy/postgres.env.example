# PostgreSQL 容器的环境变量，由 docker compose 读取（deploy/compose.yaml 的 env_file）。
#
# 在部署机器上复制到 /etc/tradingagentspro/postgres.env（root 所有，权限 0600），在等号后面填值。
# 用户名和库名都是 tradingagentspro，写在 compose.yaml 里。

# 超级用户 tradingagentspro 的密码。用 openssl rand -hex 24 生成：只有 0-9a-f，写进数据库地址不用转义。
# 只在第一次初始化数据卷时生效，之后改这里不会改数据库里的密码。
POSTGRES_PASSWORD=
