# 交易侧主程序的环境变量，由 systemd 读取后交给 tradingagentspro.service。
#
# 在部署机器上复制到 /etc/tradingagentspro/tradingagentspro.env（root 所有，权限 0600），
# 在等号后面直接填值：不加引号，不留空格。这个文件只放在部署机器上，不提交到仓库。
# 变量的清单和 src/tradingagentspro/bootstrap/settings.py 的 VARIABLES 一致，由 tests/deploy 检查。

# 状态库的地址：postgresql://tradingagentspro:<数据库密码>@127.0.0.1:5432/tradingagentspro
# <数据库密码> 和 /etc/tradingagentspro/postgres.env 的 POSTGRES_PASSWORD 一样
TRADINGAGENTSPRO_DATABASE_URL=
# Alpaca 模拟盘的 API key ID（Alpaca 后台 Paper Trading 的 API Keys；重置模拟盘账户以后换成新生成的）
APCA_API_KEY_ID=
# Alpaca 模拟盘的 API secret（只在生成时显示一次）
APCA_API_SECRET_KEY=
# Discord 机器人的 token（Discord 开发者后台的 Bot 页面）
DISCORD_BOT_TOKEN=
# 服务器 ID（Discord 打开开发者模式后，右键服务器复制 ID）
DISCORD_GUILD_ID=
# 告警和确认的频道 ID（右键频道复制 ID）
DISCORD_CHANNEL_ID=
# 唯一可以按按钮、运行 /plan 的用户 ID（右键自己的头像复制 ID）
DISCORD_USER_ID=
# Finnhub 的 API key（Finnhub 网站注册免费档以后在 Dashboard 里）：财报日历、一致预期和行业
FINNHUB_API_KEY=
# 访问 SEC EDGAR 时的 User-Agent，写明联系方式，比如：tradingagentspro 你的邮箱
SEC_USER_AGENT=
